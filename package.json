{
  "name": "provenloop",
  "version": "0.1.0-alpha.0.16",
  "private": true,
  "description": "Local learning infrastructure for coding agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-release-package.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "package:pack": "npm run build && npm pack --workspace @provenloop/cli",
    "package:verify": "npm run build && node scripts/verify-release-package.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "npm run build --silent && vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tools.json --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
