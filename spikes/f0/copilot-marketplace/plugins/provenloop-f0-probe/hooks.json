{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "http",
        "url": "http://127.0.0.1:43119/hooks/sessionStart",
        "headers": {
          "X-ProvenLoop-Internal": "${PROVENLOOP_INTERNAL}"
        },
        "allowedEnvVars": [
          "PROVENLOOP_INTERNAL"
        ],
        "timeoutSec": 1
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "http",
        "url": "http://127.0.0.1:43119/hooks/userPromptSubmitted",
        "headers": {
          "X-ProvenLoop-Internal": "${PROVENLOOP_INTERNAL}"
        },
        "allowedEnvVars": [
          "PROVENLOOP_INTERNAL"
        ],
        "timeoutSec": 1
      }
    ],
